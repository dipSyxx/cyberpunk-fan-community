Listen 127.0.0.1:3081 http

<VirtualHost 127.0.0.1:3081>
    ServerName 127.0.0.1
    ProxyRequests Off
    ProxyPass /api/ http://127.0.0.1:3001/api/
    ProxyPassReverse /api/ http://127.0.0.1:3001/api/

    <Location /api/>
        AuthType Basic
        AuthName "Cyberpunk API upstream"
        AuthBasicProvider file
        AuthUserFile /etc/apache2/cyberpunk-community-auth/vercel.htpasswd
        <RequireAll>
            Require local
            Require user vercel
            <RequireAny>
                Require expr "req_novary('X-Real-IP') =~ m#^([0-9]{1,3}[.]){3}[0-9]{1,3}$# && (req_novary('X-Real-IP') -ipmatch '0.0.0.0/1' || req_novary('X-Real-IP') -ipmatch '128.0.0.0/1')"
                # Apache evaluates IPv4-mapped IPv6 addresses against IPv4 ranges.
                Require expr "req_novary('X-Real-IP') =~ m#^[0-9A-Fa-f:.]*:[0-9A-Fa-f:.]*$# && (req_novary('X-Real-IP') -ipmatch '::/1' || req_novary('X-Real-IP') -ipmatch '8000::/1' || req_novary('X-Real-IP') -ipmatch '0.0.0.0/1' || req_novary('X-Real-IP') -ipmatch '128.0.0.0/1')"
            </RequireAny>
        </RequireAll>

        # Late request headers run after Apache has checked the proxy credential.
        RequestHeader unset Authorization
        RequestHeader set X-Cyberpunk-Proxy-Client-IP "expr=%{req:X-Real-IP}"
        RequestHeader unset X-Real-IP
        Header onsuccess unset Cache-Control
        Header always set Cache-Control "private, no-store"
    </Location>

    <LocationMatch "^/(?!api/)">
        Require all denied
    </LocationMatch>

    ErrorLog ${APACHE_LOG_DIR}/cyberpunk-community-error.log
    CustomLog ${APACHE_LOG_DIR}/cyberpunk-community-access.log combined
</VirtualHost>
