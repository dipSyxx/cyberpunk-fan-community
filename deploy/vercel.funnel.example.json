{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "https://yurili-lamp.tail-example.ts.net/api/$1",
      "headers": {
        "Cache-Control": "private, no-store",
        "CDN-Cache-Control": "no-store",
        "Vercel-CDN-Cache-Control": "no-store",
        "x-vercel-enable-rewrite-caching": "0"
      },
      "transforms": [
        {
          "type": "request.headers",
          "op": "delete",
          "target": { "key": "X-Real-IP" }
        },
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "Authorization" },
          "args": "$CYBERPUNK_FUNNEL_AUTHORIZATION",
          "env": ["CYBERPUNK_FUNNEL_AUTHORIZATION"]
        },
        {
          "type": "response.headers",
          "op": "delete",
          "target": { "key": "WWW-Authenticate" }
        }
      ]
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
