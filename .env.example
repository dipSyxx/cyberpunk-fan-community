# Backend only. Keep the configured public origin identical to the browser URL.
CYBERPUNK_APP_ORIGIN=http://localhost:5173
CYBERPUNK_API_PORT=3001
CYBERPUNK_AUTH_SECRET=
CYBERPUNK_TRUST_LOCAL_PROXY=0

CYBERPUNK_DB_HOST=127.0.0.1
CYBERPUNK_DB_PORT=3306
# Optional Unix socket on Ubuntu. Use a verified CA for a non-loopback TCP host.
# CYBERPUNK_DB_SOCKET=/run/mysqld/mysqld.sock
# CYBERPUNK_DB_TLS_CA=/path/to/database-ca.pem
CYBERPUNK_DB_USER=cyberpunk_app
CYBERPUNK_DB_PASSWORD=

# Supply these only to migration commands.
CYBERPUNK_MIGRATION_USER=cyberpunk_migrator
CYBERPUNK_MIGRATION_PASSWORD=
